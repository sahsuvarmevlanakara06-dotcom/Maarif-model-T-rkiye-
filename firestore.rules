rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLeaderboardEntry(data, expectedUserId) {
      return data.userId is string
          && data.userId == expectedUserId
          && data.displayName is string
          && data.displayName.size() >= 1
          && data.displayName.size() <= 30
          && data.avatarColorIndex is int
          && data.avatarColorIndex >= 0
          && data.avatarColorIndex <= 5
          && data.grade is int
          && data.grade >= 5
          && data.grade <= 12
          && data.totalPoints is int
          && data.totalPoints >= 0
          && data.weeklyPoints is int
          && data.weeklyPoints >= 0
          && data.weekKey is string
          && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
          && data.streakCount is int
          && data.streakCount >= 0
          && data.streakCount <= 10000
          && data.perfectQuizCount is int
          && data.perfectQuizCount >= 0
          && data.perfectQuizCount <= 100000
          && data.activeMultiplier is int
          && data.activeMultiplier >= 1
          && data.activeMultiplier <= 1000000
          && data.publicVisible is bool
          && data.publicVisible == true;
    }

    // 3. Real-Time Global & Weekly Student Leaderboard (Non-PII Public Ranking Collection)
    match /leaderboard/{userId} {
      // Signed-in users can read/list only explicitly publicVisible leaderboard entries
      allow get, list: if isSignedIn() && resource.data.publicVisible == true;

      // Users can only create their own leaderboard entry with complete, validated fields
      allow create: if isOwner(userId)
          && isValidId(userId)
          && incoming().keys().hasAll([
              'userId',
              'displayName',
              'avatarColorIndex',
              'grade',
              'totalPoints',
              'weeklyPoints',
              'weekKey',
              'streakCount',
              'perfectQuizCount',
              'activeMultiplier',
              'publicVisible',
              'createdAt',
              'updatedAt'
          ])
          && incoming().keys().hasOnly([
              'userId',
              'displayName',
              'avatarColorIndex',
              'grade',
              'totalPoints',
              'weeklyPoints',
              'weekKey',
              'streakCount',
              'perfectQuizCount',
              'activeMultiplier',
              'publicVisible',
              'createdAt',
              'updatedAt'
          ])
          && isValidLeaderboardEntry(incoming(), userId)
          && incoming().createdAt is timestamp
          && incoming().createdAt <= request.time
          && incoming().updatedAt is timestamp
          && incoming().updatedAt <= request.time;

      // Users can only update their own leaderboard entry, keeping userId and createdAt immutable
      allow update: if isOwner(userId)
          && isValidId(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'avatarColorIndex',
              'grade',
              'totalPoints',
              'weeklyPoints',
              'weekKey',
              'streakCount',
              'perfectQuizCount',
              'activeMultiplier',
              'publicVisible',
              'updatedAt'
          ])
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && isValidLeaderboardEntry(incoming(), userId)
          && incoming().updatedAt is timestamp
          && incoming().updatedAt <= request.time;

      // Users can delete only their own leaderboard entry
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
